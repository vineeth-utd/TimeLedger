NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Runtime connection: Supabase Transaction Pooler (port 6543)
DATABASE_URL=
# Prisma CLI / migrations: Supabase direct connection (port 5432), or the Session Pooler
# (pooler host, port 5432) if direct/IPv6 is unavailable. Never the transaction pooler.
DIRECT_URL=

# AI assistant (server-only). The LLM and speech-to-text providers are selected independently.
AI_PROVIDER=                # groq (default) | openai-compatible
STT_PROVIDER=               # groq (default) | openai-compatible

# Groq (default provider)
GROQ_API_KEY=
# Generic OpenAI-compatible API (required when AI_PROVIDER=openai-compatible or STT_PROVIDER=openai-compatible)
OPENAI_COMPATIBLE_API_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Model ids are per provider (only the selected provider's variables are read)
# GROQ_AI_MODEL=openai/gpt-oss-120b            # default
# OPENAI_COMPATIBLE_AI_MODEL=gpt-oss-120b      # default

# Voice input / speech-to-text (uses the STT_PROVIDER's credentials)
# GROQ_STT_MODEL=whisper-large-v3-turbo        # default
# OPENAI_COMPATIBLE_STT_MODEL=whisper-large-v3 # default

# GROQ_AI_MAX_OUTPUT_TOKENS=512                    # max output tokens per call (default 512, tuned to Groq's TPM limit)
# OPENAI_COMPATIBLE_AI_MAX_OUTPUT_TOKENS=1024      # default 1024; invalid/zero/negative values fall back to the default
# GROQ_AI_REASONING_EFFORT=low    # low | medium | high (default low); Groq only. Not sent to the openai-compatible provider
# Weekly AI Productivity Agent report output cap, per provider (default 2048 each; invalid/zero/negative fall back)
# GROQ_REPORT_MAX_OUTPUT_TOKENS=2048
# OPENAI_COMPATIBLE_REPORT_MAX_OUTPUT_TOKENS=2048
# OPENAI_COMPATIBLE_REPORT_REASONING_EFFORT=low   # none | low | medium | high; weekly reports on the openai-compatible provider only.
#                                                 # Unset/empty = not sent (provider default); any other value is a configuration error.
# AI_CHECKPOINTER=memory   # default is PostgreSQL (schema ai_checkpoints); run scripts/ai-setup-checkpointer.mjs once
# AI_LOG_USAGE=true        # log per-call token usage, prompt-cache hits and rate-limit headers (no content)

# Scheduled weekly report generation (Vercel Cron bearer token authentication)
# CRON_SECRET=

# Supabase Service Role Key (server-only, used by background scheduler to look up account email by userId)
# SUPABASE_SERVICE_ROLE_KEY=

# Weekly Report Email Delivery (Resend HTTPS API)
# RESEND_API_KEY=
# EMAIL_FROM=TimeLedger <reports@yourdomain.com>