NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Runtime connection: Supabase Transaction Pooler (port 6543)
DATABASE_URL=
# Prisma CLI / migrations: Supabase direct connection (port 5432), or the Session Pooler
# (pooler host, port 5432) if direct/IPv6 is unavailable. Never the transaction pooler.
DIRECT_URL=
# AI assistant (server-only)
GROQ_API_KEY=
AI_MODEL=
# AI_MODEL=openai/gpt-oss-120b
# AI_MAX_OUTPUT_TOKENS=512   # maximum model output tokens per call (default 512)
# AI_REASONING_EFFORT=low    # low | medium | high (default low)
# AI_CHECKPOINTER=memory   # default is PostgreSQL (schema ai_checkpoints); run scripts/ai-setup-checkpointer.mjs once
# AI_LOG_USAGE=true        # log per-call token usage, prompt-cache hits and rate-limit headers (no content)
# Voice input / speech-to-text (uses GROQ_API_KEY)
# STT_MODEL=whisper-large-v3-turbo   # default; independent of AI_MODEL
